# Copy to .env (gitignored). Operator-supplied live path only.
# X Media Studio / go-live: RTMP or RTMPS ingest URL + stream key.
# No secrets in docker-compose.yml.
# Sign in = these env vars, or PUT /api/live/credentials (local 0600 file).
# Headless docker run: --env-file .env (these fields). Never commit .env.

# Live source (YouTube first)
SOURCE_URL=

# X live ingest (rtmp:// or rtmps://). Env wins over the local credentials file.
RETRANS_X_RTMP_URL=
RETRANS_X_RTMP_KEY=
